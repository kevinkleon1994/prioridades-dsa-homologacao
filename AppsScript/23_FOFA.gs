function prepararEstruturaFofaV13() {
  const ss = db_();
  const schemas = {
    FOFA_ITENS: REQUIRED_SCHEMA.FOFA_ITENS,
    FOFA_AVALIACOES: REQUIRED_SCHEMA.FOFA_AVALIACOES,
    FOFA_RESPOSTAS: REQUIRED_SCHEMA.FOFA_RESPOSTAS,
    FOFA_CRUZAMENTOS: REQUIRED_SCHEMA.FOFA_CRUZAMENTOS,
    FOFA_PRIORIZACAO: REQUIRED_SCHEMA.FOFA_PRIORIZACAO,
    FOFA_PLANOS_ACAO: REQUIRED_SCHEMA.FOFA_PLANOS_ACAO
  };

  Object.keys(schemas).forEach(name => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    const headers = schemas[name];
    if (sh.getLastRow() === 0 || !String(sh.getRange(1,1).getValue() || '').trim()) {
      sh.getRange(1,1,1,headers.length).setValues([headers]);
      sh.setFrozenRows(1);
      sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#0E2A3B').setFontColor('#FFFFFF');
    }
  });

  if (!rows_(APP.SHEETS.FOFA_ITEMS, 'fofa_item_id').length) {
    FOFA_SEED_V21.forEach(item => appendObject_(APP.SHEETS.FOFA_ITEMS, item));
  }

  const cfg = findByField_(APP.SHEETS.CONFIG, 'chave', 'chave', 'VERSAO_BANCO');
  if (cfg) {
    updateObjectRow_(APP.SHEETS.CONFIG, cfg._row, {valor:'1.3'});
  } else {
    appendObject_(APP.SHEETS.CONFIG, {chave:'VERSAO_BANCO',valor:'1.3',descricao:'Versão da Planilha-Mestre com arquitetura FOFA'});
  }

  logSystem_('PREPARAR_ESTRUTURA_FOFA_V13','FOFA','',{itens:FOFA_SEED_V21.length});
  return {ok:true,db_version:'1.3',itens:FOFA_SEED_V21.length};
}

function fofaClassificacao_(score) {
  const n=Number(score||0);
  if(n>=400) return 'Crítica';
  if(n>=250) return 'Alta';
  if(n>=100) return 'Moderada';
  return 'Baixa';
}

function fofaIndiceEixo_(responses,eixo) {
  const internal=responses.filter(r=>String(r.eixo||'')===eixo && ['Força','Fraqueza'].includes(String(r.tipo_fofa||'')) && Number(r.nota||0)>0);
  if(!internal.length) return 0;
  let total=0;
  internal.forEach(r=>{
    let n=Math.max(1,Math.min(5,Number(r.nota||0)));
    if(String(r.tipo_fofa)==='Fraqueza') n=6-n;
    total+=n;
  });
  return Math.round((total/(internal.length*5))*1000)/10;
}

function fofaEvaluationSummary_(evaluationId) {
  const evaluation=findById_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id',evaluationId);
  if(!evaluation) return null;
  const responses=rows_(APP.SHEETS.FOFA_RESPONSES,'resposta_id').filter(r=>String(r.avaliacao_id||'')===String(evaluationId));
  const indices={
    Identidade:fofaIndiceEixo_(responses,'Identidade'),
    Liderança:fofaIndiceEixo_(responses,'Liderança'),
    'Novas Gerações':fofaIndiceEixo_(responses,'Novas Gerações'),
    Discipulado:fofaIndiceEixo_(responses,'Discipulado')
  };
  const vals=Object.values(indices).filter(n=>n>0);
  const geral=vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length*10)/10:0;
  return {evaluation:publicRow_(evaluation),responses:responses.map(r=>publicRow_(r)),indices:indices,indice_geral:geral};
}

function listFofaItems_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const eixo=String(input.eixo||'').trim();
  let items=rows_(APP.SHEETS.FOFA_ITEMS,'fofa_item_id').filter(x=>bool_(x.ativo));
  if(eixo) items=items.filter(x=>String(x.eixo||'')===eixo);
  items.sort((a,b)=>String(a.eixo||'').localeCompare(String(b.eixo||'')) || Number(a.ordem||0)-Number(b.ordem||0));
  return {ok:true,data:items.map(x=>publicRow_(x))};
}

function listFofaEvaluations_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const context=normalizeContext_(user,input||{});
  let rows=rows_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id');
  if(context.igreja_id) {
    requireChurch_(user,context.igreja_id);
    rows=rows.filter(x=>String(x.igreja_id||'')===String(context.igreja_id));
  } else {
    const allowed=new Set(contextualChurches_(user,context).map(x=>String(x.igreja_id||'')));
    rows=rows.filter(x=>allowed.has(String(x.igreja_id||'')));
  }
  rows.sort((a,b)=>String(b.criado_em||'').localeCompare(String(a.criado_em||'')));
  return {ok:true,data:rows.map(x=>publicRow_(x))};
}

function startFofaEvaluation_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const churchId=String(input.igreja_id||'').trim();
  if(!churchId) throw new Error('Selecione uma igreja para iniciar a Matriz FOFA.');
  requireChurch_(user,churchId);
  const id=nextId_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id','FAV');
  const now=new Date();
  appendObject_(APP.SHEETS.FOFA_EVALUATIONS,{
    avaliacao_id:id,igreja_id:churchId,ano:Number(input.ano||new Date().getFullYear()),
    tipo_ciclo:String(input.tipo_ciclo||'Diagnóstico Inicial'),status:'Em avaliação',
    data_inicio:parseDateOnly_(input.data_inicio)||now,criado_por:String(user.usuario_id||''),criado_em:now
  });
  logUser_(user,'CRIAR_AVALIACAO_FOFA','FOFA_AVALIACAO',id,{igreja_id:churchId,tipo_ciclo:String(input.tipo_ciclo||'Diagnóstico Inicial')});
  return {ok:true,avaliacao_id:id};
}

function getFofaEvaluation_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const id=String(input.avaliacao_id||'').trim();
  const summary=fofaEvaluationSummary_(id);
  if(!summary) throw new Error('Avaliação FOFA não encontrada.');
  requireChurch_(user,String(summary.evaluation.igreja_id||''));
  return Object.assign({ok:true},summary);
}

function saveFofaResponse_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const evaluation=findById_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id',input.avaliacao_id);
  if(!evaluation) throw new Error('Avaliação FOFA não encontrada.');
  requireChurch_(user,String(evaluation.igreja_id||''));
  const item=findById_(APP.SHEETS.FOFA_ITEMS,'fofa_item_id',input.fofa_item_id);
  if(!item) throw new Error('Item FOFA não encontrado.');

  let current=rows_(APP.SHEETS.FOFA_RESPONSES,'resposta_id').find(r=>String(r.avaliacao_id||'')===String(input.avaliacao_id) && String(r.fofa_item_id||'')===String(input.fofa_item_id));
  const impacto=Math.max(0,Math.min(5,Number(input.impacto||0)));
  const urgencia=Math.max(0,Math.min(5,Number(input.urgencia||0)));
  const governabilidade=Math.max(0,Math.min(5,Number(input.governabilidade||0)));
  const alinhamento=Math.max(0,Math.min(5,Number(input.alinhamento||0)));
  const score=(impacto&&urgencia&&governabilidade&&alinhamento)?impacto*urgencia*governabilidade*alinhamento:0;
  const patch={
    avaliacao_id:String(input.avaliacao_id),fofa_item_id:String(item.fofa_item_id),igreja_id:String(evaluation.igreja_id||''),
    eixo:String(item.eixo||''),tipo_fofa:String(item.tipo_fofa||''),fator:String(item.fator||''),
    nota:Number(input.nota||0),evidencia:String(input.evidencia||''),fonte_evidencia:String(input.fonte_evidencia||''),
    observacao:String(input.observacao||''),impacto:impacto,urgencia:urgencia,governabilidade:governabilidade,
    alinhamento:alinhamento,indice_prioridade:score,classificacao:score?fofaClassificacao_(score):'',
    meta_relacionada:String(item.meta_relacionada||''),resultado_atual:String(input.resultado_atual||''),
    meta:String(input.meta||''),gap:String(input.gap||''),avaliado_por:String(user.usuario_id||''),avaliado_em:new Date()
  };
  if(current) updateObjectRow_(APP.SHEETS.FOFA_RESPONSES,current._row,patch);
  else {
    patch.resposta_id=nextId_(APP.SHEETS.FOFA_RESPONSES,'resposta_id','FRS');
    appendObject_(APP.SHEETS.FOFA_RESPONSES,patch);
  }
  logUser_(user,'SALVAR_RESPOSTA_FOFA','FOFA_RESPOSTA',String(patch.resposta_id||current?.resposta_id||''),{avaliacao_id:input.avaliacao_id,fofa_item_id:input.fofa_item_id,indice_prioridade:score});
  return {ok:true,indice_prioridade:score,classificacao:score?fofaClassificacao_(score):''};
}

function concludeFofaEvaluation_(user,input) {
  requireModule_(user,APP.MODULE_KEYS.REPORTS);
  const summary=fofaEvaluationSummary_(String(input.avaliacao_id||''));
  if(!summary) throw new Error('Avaliação FOFA não encontrada.');
  requireChurch_(user,String(summary.evaluation.igreja_id||''));
  const row=findById_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id',input.avaliacao_id);
  const indices=summary.indices, geral=summary.indice_geral;
  let cls='Situação crítica';
  if(geral>=80) cls='Consolidado'; else if(geral>=65) cls='Desenvolvimento saudável'; else if(geral>=50) cls='Atenção estratégica'; else if(geral>=35) cls='Fragilidade';
  updateObjectRow_(APP.SHEETS.FOFA_EVALUATIONS,row._row,{
    status:'Concluído',data_conclusao:new Date(),
    indice_diagnostico_identidade:indices.Identidade,indice_diagnostico_lideranca:indices.Liderança,
    indice_diagnostico_novas_geracoes:indices['Novas Gerações'],indice_diagnostico_discipulado:indices.Discipulado,
    indice_diagnostico_geral:geral,classificacao:cls,concluido_por:String(user.usuario_id||''),concluido_em:new Date()
  });
  logUser_(user,'CONCLUIR_AVALIACAO_FOFA','FOFA_AVALIACAO',String(input.avaliacao_id),{indice_geral:geral,classificacao:cls});
  return {ok:true,indices:indices,indice_geral:geral,classificacao:cls};
}

function latestFofaForChurch_(user,churchId) {
  if(!churchId) return null;
  requireChurch_(user,String(churchId));
  const evaluations=rows_(APP.SHEETS.FOFA_EVALUATIONS,'avaliacao_id')
    .filter(x=>String(x.igreja_id||'')===String(churchId) && String(x.status||'')==='Concluído')
    .sort((a,b)=>String(b.concluido_em||b.criado_em||'').localeCompare(String(a.concluido_em||a.criado_em||'')));
  if(!evaluations.length) return null;
  return fofaEvaluationSummary_(evaluations[0].avaliacao_id);
}

function fofaHistory_(user,input) {
  const list=listFofaEvaluations_(user,input).data||[];
  const data=list.map(ev=>{
    const s=fofaEvaluationSummary_(ev.avaliacao_id);
    return {avaliacao:ev,indices:s?s.indices:{},indice_geral:s?s.indice_geral:0};
  });
  return {ok:true,data:data};
}
